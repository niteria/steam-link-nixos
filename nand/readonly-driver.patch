+static int berlin_wait_status(struct marvell_nfc *nfc, u32 mask)
+{
+	u32 status;
+	int ret = readl_relaxed_poll_timeout_atomic(nfc->regs + NDSR, status,
+						status & mask, 1, POLL_TIMEOUT);
+	if (ret)
+		dev_err(nfc->dev, "Berlin timeout mask=%08x status=%08x ctrl=%08x\n",
+			mask, status, readl(nfc->regs + NDCR));
+	return ret;
+}
+
+static int berlin_send_read_command(struct marvell_nfc *nfc, u32 command,
+				   u32 address1, u32 address2, u32 length)
+{
+	int ret = berlin_wait_status(nfc, NDSR_WRCMDREQ);
+	if (ret)
+		return ret;
+	writel(NDSR_WRCMDREQ, nfc->regs + NDSR);
+	writel(command, nfc->regs + NDCB0);
+	writel(address1, nfc->regs + NDCB0);
+	writel(address2, nfc->regs + NDCB0);
+	if (command & NDCB0_LEN_OVRD)
+		writel(length, nfc->regs + NDCB0);
+	return 0;
+}
+
+static int berlin_read_fifo(struct marvell_nfc *nfc, u8 *buffer, unsigned int size)
+{
+	unsigned int offset;
+	int ret;
+	for (offset = 0; offset < size; offset += 32) {
+		ret = berlin_wait_status(nfc, NDSR_RDDREQ);
+		if (ret)
+			return ret;
+		writel(NDSR_RDDREQ, nfc->regs + NDSR);
+		ioread32_rep(nfc->regs + NDDB, buffer + offset, 8);
+	}
+	return 0;
+}
+
+static int berlin_read_page(struct nand_chip *chip, u8 *buffer, int page)
+{
+	struct marvell_nfc *nfc = to_marvell_nfc(chip->controller);
+	struct mtd_info *mtd = nand_to_mtd(chip);
+	u32 status[2] = { 0 };
+	unsigned int chunk, i;
+	int ret, max_bitflips = 0;
+	u8 *spare = chip->oob_poi;
+	if (!buffer)
+		buffer = nand_get_data_buf(chip);
+	memset(spare, 0xff, mtd->oobsize);
+	marvell_nfc_select_target(chip, chip->cur_cs);
+	writel(0, nfc->regs + NDCR);
+	/* Match the stock start sequence: flush the stop before retuning BCH. */
+	readl(nfc->regs + NDECCCTRL);
+	writel(48U << 24, nfc->regs + NDECCCTRL);
+	readl(nfc->regs + NDECCCTRL);
+	writel((48U << 24) | NDECCCTRL_BCH_EN, nfc->regs + NDECCCTRL);
+	readl(nfc->regs + NDECCCTRL);
+	writel(0xffffffff, nfc->regs + NDSR);
+	/* Qualified stock settings: 4KiB page, 256 pages/block, 8-bit bus.
+	 * SPARE_EN stays clear; only the final data transfer includes 32 OOB bytes. */
+	writel(0x0106f000 | NDCR_ALL_INT | NDCR_ND_RUN | NDCR_ECC_EN,
+	       nfc->regs + NDCR);
+	ret = berlin_send_read_command(nfc, (6U << 29) | BIT(20) | NDCB0_DBC |
+				      NDCB0_ADDR_CYC(5) | 0x3000,
+				      (page & 0xffff) << 16, (page >> 16) & 0xff, 0);
+	if (ret)
+		goto out;
+	ret = berlin_wait_status(nfc, NDSR_RDY(0));
+	if (ret)
+		goto out;
+	writel(NDSR_RDY(0) | NDSR_CMDD(0), nfc->regs + NDSR);
+	for (chunk = 0; chunk < 2; chunk++) {
+		u32 command = (5U << 29) | NDCB0_LEN_OVRD;
+		if (!chunk)
+			command |= BIT(20);
+		ret = berlin_send_read_command(nfc, command, 0, 0,
+					      2048 + (chunk ? 32 : 0));
+		if (ret)
+			goto out;
+		ret = berlin_read_fifo(nfc, buffer + chunk * 2048, 2048);
+		if (ret)
+			goto out;
+		if (chunk) {
+			ret = berlin_read_fifo(nfc, spare, 32);
+			if (ret)
+				goto out;
+		}
+		status[chunk] = readl(nfc->regs + NDSR);
+		writel(NDSR_CORERR | NDSR_UNCERR, nfc->regs + NDSR);
+	}
+	ret = berlin_wait_status(nfc, NDSR_CMDD(0));
+	if (ret)
+		goto out;
+	for (chunk = 0; chunk < 2; chunk++) {
+		unsigned int corrected = 0;
+		if (status[chunk] & NDSR_UNCERR) {
+			/* Like the stock driver, accept a nearly erased chunk only
+			 * when data and its exposed spare have fewer than 48 zero bits. */
+			for (i = 0; i < 2048; i++)
+				corrected += hweight8((u8)~buffer[chunk * 2048 + i]);
+			if (chunk)
+				for (i = 0; i < 32; i++)
+					corrected += hweight8((u8)~spare[i]);
+			if (corrected >= 48) {
+				mtd->ecc_stats.failed++;
+				ret = -EBADMSG;
+				goto out;
+			}
+			memset(buffer + chunk * 2048, 0xff, 2048);
+			if (chunk)
+				memset(spare, 0xff, 32);
+		} else if (status[chunk] & NDSR_CORERR) {
+			corrected = NDSR_ERRCNT(status[chunk]);
+		}
+		mtd->ecc_stats.corrected += corrected;
+		max_bitflips = max_t(int, max_bitflips, corrected);
+	}
+	ret = max_bitflips;
+out:
+	writel(NDCR_ALL_INT, nfc->regs + NDCR);
+	writel(0xffffffff, nfc->regs + NDSR);
+	cond_resched();
+	return ret;
+}
